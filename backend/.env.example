# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/employee-system

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (used for CORS)
CORS_ORIGIN=http://localhost:5173

# Optional: enables the AI recommendations feature (https://openrouter.ai)
OPENROUTER_API_KEY=
